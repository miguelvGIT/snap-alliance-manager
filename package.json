{
  "name": "snap-alliance-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "dev": "node scripts/prepare-ocr.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-ocr.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "node scripts/prepare-ocr.mjs && playwright test",
    "dev:api": "wrangler dev --local --port 8787",
    "db:migrate": "wrangler d1 migrations apply alliance-db --local",
    "check": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.2.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251001.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.0",
    "wrangler": "^4.45.0"
  }
}
